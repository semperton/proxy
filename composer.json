{
	"name": "semperton/proxy",
	"description": "Simple PSR-18 HTTP client based on PHP's native stream socket.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"http",
		"http-client",
		"psr-18",
		"psr-7",
		"socket",
		"stream"
	],
	"authors": [
		{
			"name": "Johannes Rabausch",
			"homepage": "https://github.com/jrabausch"
		}
	],
	"autoload": {
		"psr-4": {
			"Semperton\\Proxy\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Semperton\\Proxy\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": "^8.1",
		"psr/http-client": "^1.0.3",
		"psr/http-message": "^1.1 || ^2.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"httpsoft/http-message": "^1.1",
		"phpunit/phpunit": "^10.5 || ^11.5 || ^12.5",
		"vimeo/psalm": "^6.20"
	},
	"provide": {
		"psr/http-client-implementation": "1.0"
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"cs": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache",
		"check": [
			"@cs",
			"@psalm",
			"@test"
		]
	}
}
